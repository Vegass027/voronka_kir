# .env.example - Шаблон для переменных окружения в продакшене
# Не храните в репозитории чувствительные данные напрямую

# --- Telegram Bot ---
# Токен для доступа к Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
# URL для подключения к базе данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@host:port/database_name

# --- Supabase ---
# URL и ключи для работы с Supabase API
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- API Keys ---
# API ключи для различных сервисов
FAL_AI_API_KEY=your_fal_ai_api_key_here
OPEN_AI_API_KEY=your_openai_api_key_here

# --- Admin ---
# Telegram ID администратора для предоставления особых прав
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here